{
  "name": "vscode-pretty-json",
  "displayName": "vscode-pretty-json",
  "description": "Visual Studio Code extension that provides commands to format JSON",
  "version": "2.3.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrismeyers/vscode-pretty-json.git"
  },
  "license": "MIT",
  "publisher": "chrismeyers",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Formatters"
  ],
  "icon": "images/icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-pretty-json.prettify",
        "title": "Pretty JSON: Prettify"
      },
      {
        "command": "vscode-pretty-json.uglify",
        "title": "Pretty JSON: Uglify"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "clean": "rimraf dist",
    "compile": "npm run check-types && npm run lint && npm run clean && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "npm run clean && node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && npm run clean && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check '**/*.{ts,js,mjs,cjs}'",
    "format:fix": "oxfmt '**/*.{ts,js,mjs,cjs}'",
    "test": "vscode-test"
  },
  "dependencies": {
    "lossless-json": "^4.3.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
